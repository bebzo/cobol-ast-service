{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["iad1"],
  "functions": {
    "api/transpile.py": {
      "maxDuration": 60,
      "memory": 1024,
      "runtime": "python3.9"
    },
    "app/api/analyse/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "app/api/analyse-stream/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "app/api/clean/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "app/api/transpile-clean/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "app/api/ast/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "app/api/chat/route.ts": {
      "maxDuration": 60,
      "memory": 512
    }
  }
}
