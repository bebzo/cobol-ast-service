# ============================================================
# COBOL-to-Python Transpiler - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values

# Environment
ENVIRONMENT=development  # development | staging | production
DEBUG=false

# ============================================================
# SUPABASE CONFIGURATION - CRITICAL FOR PRODUCTION
# ============================================================
# Get these from your Supabase project:
# 1. Go to https://supabase.com/dashboard
# 2. Select your project
# 3. Go to Project Settings > API
# 4. Copy the URL and anon key

# Project URL (required)
SUPABASE_URL=https://your-project.supabase.co

# Anon key (safe for client-side use)
SUPABASE_ANON_KEY=your-anon-key

# Service role key (admin operations ONLY - keep secret!)
SUPABASE_SERVICE_KEY=your-service-role-key

# ============================================================
# Authentication
# ============================================================
JWT_SECRET=your-secure-jwt-secret-min-32-chars
SESSION_TIMEOUT_MINUTES=60
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# ============================================================
# Security
# ============================================================
ALLOW_STUBS=false
REQUIRE_AUTH=true
LOG_LEVEL=INFO
ENCRYPT_SENSITIVE_DATA=true

# ============================================================
# File Paths
# ============================================================
CUSTOMER_MASTER_PATH=./data/customer_master.dat
TRANSACTION_LOG_PATH=./data/transactions.log
AUDIT_TRAIL_PATH=./data/audit_trail.dat
TEMP_WORK_PATH=./data/temp_work.dat

# Business Rules - Interest Rates
SAVINGS_RATE=0.0225
CHECKING_RATE=0.001
MM_RATE=0.035
CD_RATE_1YR=0.045
CD_RATE_2YR=0.050
CD_RATE_5YR=0.055

# Business Rules - Loan Rates
MORTGAGE_RATE_30=0.0675
MORTGAGE_RATE_15=0.0625
AUTO_LOAN_RATE=0.0725
PERSONAL_LOAN_RATE=0.1199

# Business Rules - Fees
OVERDRAFT_FEE=35.00
NSF_FEE=35.00
WIRE_FEE_DOMESTIC=25.00
WIRE_FEE_INTL=45.00
LATE_PAYMENT_FEE=39.00

# Business Rules - Limits
MAX_SINGLE_TRANSACTION=100000.00
DAILY_WITHDRAWAL_LIMIT=10000.00
DAILY_TRANSFER_LIMIT=50000.00

# Fraud Detection
FRAUD_THRESHOLD=100

# Tax
DEFAULT_TAX_RATE=0.20
